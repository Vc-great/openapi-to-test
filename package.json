{
  "name": "openapi-to-consumer-verification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "openapi:version": "pnpm exec openapi --version",
    "spec:validate": "pnpm exec openapi validate fixtures/basic/openapi.yaml",
    "spec:inspect": "pnpm exec openapi inspect fixtures/basic/openapi.yaml --json",
    "generate:preview": "pnpm exec openapi generate --target manual-full --dry-run --json",
    "generate": "pnpm exec openapi generate --target manual-full --json",
    "generate:check": "pnpm exec openapi generate --target manual-full --check --json",
    "typecheck": "pnpm exec tsc",
    "verify:generated": "node scripts/verify-generated-output.mjs",
    "verify": "pnpm spec:validate && pnpm spec:inspect && pnpm generate:check && pnpm typecheck && pnpm verify:generated"
  },
  "dependencies": {
    "zod": "3.x"
  },
  "devDependencies": {
    "openapi-to": "4.0.0-rc.0",
    "typescript": "5.6.2"
  }
}
